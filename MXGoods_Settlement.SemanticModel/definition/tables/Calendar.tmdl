/// Calendar covering the full months in the export
table Calendar
	lineageTag: c244199a-d4d3-47e4-815a-662457a71726
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: dd mmm yyyy
		lineageTag: 6ab30068-17b9-423a-9a87-ea849b13c6f3
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: ef8a7f1f-4e64-419a-8b50-e6c8c28ed64c
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	column 'Month No'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 38cd5ecd-b3c4-4332-812e-388322c2d21e
		summarizeBy: none
		sourceColumn: Month No

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: c1fda23e-daa5-4d5c-b5c3-d022764c324d
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month No'

		annotation SummarizationSetBy = Automatic

	column 'Week Start'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: 68813cce-1273-4a3c-be90-404ed2b2d9ab
		summarizeBy: none
		sourceColumn: Week Start

		annotation SummarizationSetBy = Automatic

	column 'Weekday No'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 406774ad-b9dc-46d0-be6c-6a8671fb6e78
		summarizeBy: none
		sourceColumn: Weekday No

		annotation SummarizationSetBy = Automatic

	column Weekday
		dataType: string
		lineageTag: d34e06d7-2f59-4233-bf92-3c4b3ed1f6e5
		summarizeBy: none
		sourceColumn: Weekday
		sortByColumn: 'Weekday No'

		annotation SummarizationSetBy = Automatic

	column 'Day Label'
		dataType: string
		lineageTag: e0b8b3e1-8b5f-48c2-9c4c-439dababd93b
		summarizeBy: none
		sourceColumn: Day Label
		sortByColumn: Date

		annotation SummarizationSetBy = Automatic

	partition Calendar = m
		mode: import
		source =
				let
				    Dates = List.Transform(Settlement[Transaction Date], each _),
				    StartDate = Date.StartOfMonth(List.Min(Dates)),
				    EndDate = Date.EndOfMonth(List.Max(Dates)),
				    DayList = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
				    Base = Table.FromList(DayList, Splitter.SplitByNothing(), type table [Date = date]),
				    AddYear = Table.AddColumn(Base, "Year", each Date.Year([Date]), Int64.Type),
				    AddMonthNo = Table.AddColumn(AddYear, "Month No", each Date.Month([Date]), Int64.Type),
				    AddMonth = Table.AddColumn(AddMonthNo, "Month", each Date.ToText([Date], "MMM yyyy", "en-GB"), type text),
				    AddWeek = Table.AddColumn(AddMonth, "Week Start", each Date.StartOfWeek([Date], Day.Monday), type date),
				    AddWdNo = Table.AddColumn(AddWeek, "Weekday No", each Date.DayOfWeek([Date], Day.Monday) + 1, Int64.Type),
				    AddWd = Table.AddColumn(AddWdNo, "Weekday", each Date.ToText([Date], "ddd", "en-GB"), type text),
				    AddLabel = Table.AddColumn(AddWd, "Day Label", each Date.ToText([Date], "dd MMM", "en-GB"), type text)
				in
				    AddLabel

	annotation PBI_ResultType = Table

